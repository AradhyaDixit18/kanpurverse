[
  {
    "start": 0,
    "end": 4.255,
    "text": "पिछली रील में पूछा था, कानपुर को गेम में क्या-क्या देखना चाहिए?",
    "scene": 1
  },
  {
    "start": 4.315,
    "end": 5.74,
    "text": "अब देखो पार्ट टू!",
    "scene": 1
  },
  {
    "start": 5.8,
    "end": 10.94,
    "text": "हमारे नए आइडियाज़ से, कानपुरवर्स में आ रहा है थोड़ा और कनपुरिया अंदाज़!",
    "scene": 2
  },
  {
    "start": 11.0,
    "end": 14.908,
    "text": "नुक्कड़ की पान दुकान पर जाओ, सिक्कों से पैकेट खरीदो।",
    "scene": 3
  },
  {
    "start": 14.968,
    "end": 17.352,
    "text": "गुटखा वाला गेमप्ले भी तैयार!",
    "scene": 3
  },
  {
    "start": 17.412,
    "end": 20.912,
    "text": "लेकिन सड़क पर थूका, तो नागरिक स्कोर घटेगा।",
    "scene": 3
  },
  {
    "start": 20.972,
    "end": 23.14,
    "text": "आसपास के लोग भी टोकेंगे!",
    "scene": 3
  },
  {
    "start": 23.2,
    "end": 25.892,
    "text": "और अब एन पी सी से सिर्फ हेलो नहीं।",
    "scene": 4
  },
  {
    "start": 25.952,
    "end": 28.027,
    "text": "का गुरु, बड़ी जल्दी में हो?",
    "scene": 4
  },
  {
    "start": 28.087,
    "end": 33.176,
    "text": "मज़ेदार कनपुरिया जवाब, नाराज़गी, और माफ़ी से बात सँभालना।",
    "scene": 4
  },
  {
    "start": 33.236,
    "end": 35.54,
    "text": "साफ़ भाषा का विकल्प भी है!",
    "scene": 4
  },
  {
    "start": 35.6,
    "end": 37.909,
    "text": "ये अर्ली बिल्ड है, बस शुरुआत है।",
    "scene": 5
  },
  {
    "start": 37.969,
    "end": 43.04,
    "text": "आगे के फीचर्स और मिशन्स को आकार देने में, आपके आइडियाज़ काम आएँगे।",
    "scene": 5
  },
  {
    "start": 43.1,
    "end": 45.01,
    "text": "अगला फीचर क्या होना चाहिए?",
    "scene": 6
  },
  {
    "start": 45.07,
    "end": 46.006,
    "text": "कमेंट करो!",
    "scene": 6
  },
  {
    "start": 46.066,
    "end": 48.756,
    "text": "कानपुरवर्स, वेल्टो स्टूडियोज़ की तरफ़ से।",
    "scene": 6
  },
  {
    "start": 48.816,
    "end": 50.94,
    "text": "शहर हमारा, बनाएँगे मिलकर!",
    "scene": 6
  }
]