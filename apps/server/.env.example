# KanpurVerse game server — copy to .env (never commit .env)
PORT=8787
HOST=0.0.0.0
# MongoDB Atlas (free M0 tier). Leave empty to use the local JSON file store (apps/server/data/).
MONGODB_URI=
MONGODB_DB=kanpurverse
# Long random string; tokens are HMAC-signed with it. Generate: openssl rand -hex 32
SESSION_SECRET=
# Comma-separated browser origins allowed to connect. Exact origins, or wildcards like https://*.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,https://kanpurverse.vercel.app,https://*.vercel.app
MAX_PLAYERS_PER_ROOM=32
MAX_CONN_PER_IP=6
LOG_LEVEL=info
