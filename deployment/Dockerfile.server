# KanpurVerse game server — any Docker host (Fly.io / Railway / Render free tiers, or a $0 Oracle Cloud VM)
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/
RUN npm ci --omit=dev --workspace=apps/server --workspace=packages/shared --include-workspace-root
COPY packages/shared packages/shared
COPY apps/server apps/server
# Read-only geometry for authoritative exit safety (ODbL source retained).
COPY apps/web/public/geo/kanpur.json apps/web/public/geo/kanpur.json
COPY tsconfig.base.json .
ENV NODE_ENV=production PORT=8787 HOST=0.0.0.0 DATA_DIR=/data
VOLUME /data
EXPOSE 8787
HEALTHCHECK CMD wget -qO- http://127.0.0.1:8787/health || exit 1
CMD ["npx", "tsx", "apps/server/src/index.ts"]
