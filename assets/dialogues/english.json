{
  "lang": "english",
  "lines": [
    {
      "id": "guide_babloo.greet_1",
      "npc": "guide_babloo",
      "category": "greeting",
      "text": "Come in, come in! Welcome to Kanpur. I'm Babloo, think of me as your guide here.",
      "voice": "english_male",
      "emotion": "warm",
      "next": "guide_babloo.tut_1"
    },
    {
      "id": "guide_babloo.greet_2",
      "npc": "guide_babloo",
      "category": "greeting",
      "text": "Back again? Good. Let's go see the city.",
      "voice": "english_male",
      "emotion": "happy"
    },
    {
      "id": "guide_babloo.tut_1",
      "npc": "guide_babloo",
      "category": "tutorial",
      "text": "Simple: W A S D to move, Shift to run, Space to jump. Walk up to anyone and press E to talk.",
      "voice": "english_male",
      "emotion": "neutral",
      "next": "guide_babloo.offer_1"
    },
    {
      "id": "guide_babloo.offer_1",
      "npc": "guide_babloo",
      "category": "mission_offer",
      "text": "First job is a small one. Munna's chai stall, Phool Bagh, then Sunset Point. Deal?",
      "voice": "english_male",
      "emotion": "warm",
      "mission": "tut_walk"
    },
    {
      "id": "guide_babloo.offer_2",
      "npc": "guide_babloo",
      "category": "mission_offer",
      "text": "Ever walked the Moti Jheel loop? No? Do it today, and bring a friend.",
      "voice": "english_male",
      "emotion": "happy",
      "mission": "jheel_walk"
    },
    {
      "id": "guide_babloo.done_1",
      "npc": "guide_babloo",
      "category": "mission_done",
      "text": "Brilliant! Here's your reward. You're half Kanpuriya already.",
      "voice": "english_male",
      "emotion": "excited"
    },
    {
      "id": "guide_babloo.dir_1",
      "npc": "guide_babloo",
      "category": "direction",
      "text": "Mall Road runs east, you can't miss it. The lake is west, the station is south.",
      "voice": "english_male",
      "emotion": "neutral"
    },
    {
      "id": "guide_babloo.bye_1",
      "npc": "guide_babloo",
      "category": "farewell",
      "text": "Alright, go explore. Babloo's right here if you need anything.",
      "voice": "english_male",
      "emotion": "warm"
    },
    {
      "id": "chai_munna.greet_1",
      "npc": "chai_munna",
      "category": "cafe",
      "text": "Come, sir! Strong ginger chai? Today's special.",
      "voice": "english_male",
      "emotion": "warm"
    },
    {
      "id": "chai_munna.greet_2",
      "npc": "chai_munna",
      "category": "cafe",
      "text": "Sit, sit, the table's free. Bun-maska with the chai today.",
      "voice": "english_male",
      "emotion": "happy"
    },
    {
      "id": "chai_munna.offer_1",
      "npc": "chai_munna",
      "category": "mission_offer",
      "text": "Chai alone is no fun. Call a friend, sit together for a minute. Chai's on me.",
      "voice": "english_male",
      "emotion": "warm",
      "mission": "cafe_date"
    },
    {
      "id": "chai_munna.done_1",
      "npc": "chai_munna",
      "category": "mission_done",
      "text": "See? That's Kanpur. Chai and a good chat.",
      "voice": "english_male",
      "emotion": "happy"
    },
    {
      "id": "chai_munna.idle_1",
      "npc": "chai_munna",
      "category": "idle",
      "text": "Hot chai! Ten for regular, twenty for special.",
      "voice": "english_male",
      "emotion": "neutral"
    },
    {
      "id": "auto_raju.greet_1",
      "npc": "auto_raju",
      "category": "auto",
      "text": "Where to, boss? Hop in. No meter, we go by heart.",
      "voice": "english_male",
      "emotion": "sly"
    },
    {
      "id": "auto_raju.greet_2",
      "npc": "auto_raju",
      "category": "auto",
      "text": "Need the auto? Keys are over there. One rule: don't crash it.",
      "voice": "english_male",
      "emotion": "happy"
    },
    {
      "id": "auto_raju.offer_1",
      "npc": "auto_raju",
      "category": "mission_offer",
      "text": "Mall Road loop, five checkpoints. Finish in time and it's six hundred coins. Got the nerve?",
      "voice": "english_male",
      "emotion": "excited",
      "mission": "race_mall"
    },
    {
      "id": "auto_raju.offer_2",
      "npc": "auto_raju",
      "category": "mission_offer",
      "text": "A passenger's waiting at Cafe Chowk, needs the station. Take them? Quick, the train won't wait.",
      "voice": "english_male",
      "emotion": "neutral",
      "mission": "taxi_station"
    },
    {
      "id": "auto_raju.done_1",
      "npc": "auto_raju",
      "category": "mission_done",
      "text": "Now that's driving! Here, your cut.",
      "voice": "english_male",
      "emotion": "excited"
    },
    {
      "id": "auto_raju.idle_1",
      "npc": "auto_raju",
      "category": "idle",
      "text": "Central, Central, Central! One more passenger!",
      "voice": "english_male",
      "emotion": "neutral"
    },
    {
      "id": "shop_gupta.greet_1",
      "npc": "shop_gupta",
      "category": "shop",
      "text": "Welcome! Naveen Market has everything. Kurta, shades, gamcha. Fair prices.",
      "voice": "english_male",
      "emotion": "warm"
    },
    {
      "id": "shop_gupta.greet_2",
      "npc": "shop_gupta",
      "category": "shop",
      "text": "Have a look. Buy if you like it, or just stay for chai.",
      "voice": "english_male",
      "emotion": "happy"
    },
    {
      "id": "shop_gupta.offer_1",
      "npc": "shop_gupta",
      "category": "mission_offer",
      "text": "Do me a favour? A box of laddus to Z Square, still warm. Take a vehicle, two and a half minutes.",
      "voice": "english_male",
      "emotion": "neutral",
      "mission": "delivery_sweets"
    },
    {
      "id": "shop_gupta.done_1",
      "npc": "shop_gupta",
      "category": "mission_done",
      "text": "Delivered? Well done. Here's the money, and a laddu for you.",
      "voice": "english_male",
      "emotion": "happy"
    },
    {
      "id": "shop_gupta.idle_1",
      "npc": "shop_gupta",
      "category": "idle",
      "text": "Bargain if you like, but bargain with a smile.",
      "voice": "english_male",
      "emotion": "sly"
    },
    {
      "id": "police_singh.greet_1",
      "npc": "police_singh",
      "category": "police",
      "text": "Hey, slow down. No racing on Mall Road, understood?",
      "voice": "english_male",
      "emotion": "annoyed"
    },
    {
      "id": "police_singh.greet_2",
      "npc": "police_singh",
      "category": "police",
      "text": "Everything alright? Any trouble, tell Singh Saheb.",
      "voice": "english_male",
      "emotion": "neutral"
    },
    {
      "id": "police_singh.idle_1",
      "npc": "police_singh",
      "category": "idle",
      "text": "Where's your helmet? Next time it's a fine.",
      "voice": "english_male",
      "emotion": "annoyed"
    },
    {
      "id": "ped_priya.greet_1",
      "npc": "ped_priya",
      "category": "greeting",
      "text": "Hi! You're new here, right? Come by the lake in the evening, it's beautiful.",
      "voice": "english_female",
      "emotion": "happy"
    },
    {
      "id": "ped_priya.offer_1",
      "npc": "ped_priya",
      "category": "mission_offer",
      "text": "I'm doing a photo project on the city. Get me shots of the temple, Central and the ghat? Press E at each.",
      "voice": "english_female",
      "emotion": "excited",
      "mission": "photo_city"
    },
    {
      "id": "ped_priya.done_1",
      "npc": "ped_priya",
      "category": "mission_done",
      "text": "What a frame! Thank you so much. Here, your share.",
      "voice": "english_female",
      "emotion": "excited"
    },
    {
      "id": "ped_aman.greet_1",
      "npc": "ped_aman",
      "category": "greeting",
      "text": "Where've you been? Come on, let's hit the mall, a new showroom just opened.",
      "voice": "english_male",
      "emotion": "happy"
    },
    {
      "id": "ped_aman.greet_2",
      "npc": "ped_aman",
      "category": "greeting",
      "text": "Hey, what's the scene? All good?",
      "voice": "english_male",
      "emotion": "happy"
    },
    {
      "id": "ped_sunita.greet_1",
      "npc": "ped_sunita",
      "category": "greeting",
      "text": "Careful, beta. These auto drivers drive like they own the road.",
      "voice": "english_female",
      "emotion": "annoyed"
    },
    {
      "id": "ped_vikas.greet_1",
      "npc": "ped_vikas",
      "category": "greeting",
      "text": "Z Square is that way, straight ahead.",
      "voice": "english_male",
      "emotion": "neutral"
    },
    {
      "id": "ped_rekha.greet_1",
      "npc": "ped_rekha",
      "category": "greeting",
      "text": "Hello! Heading to the station? The train's late, as always.",
      "voice": "english_female",
      "emotion": "happy"
    },
    {
      "id": "any.react_bump",
      "npc": "any",
      "category": "reaction",
      "text": "Hey, watch it!",
      "voice": "english_male",
      "emotion": "annoyed"
    },
    {
      "id": "any.react_bump2",
      "npc": "any",
      "category": "reaction",
      "text": "Left your eyes at home?",
      "voice": "english_male",
      "emotion": "annoyed"
    },
    {
      "id": "any.react_horn",
      "npc": "any",
      "category": "reaction",
      "text": "Why the horn? Want me to fly?",
      "voice": "english_male",
      "emotion": "annoyed"
    },
    {
      "id": "any.react_wave",
      "npc": "any",
      "category": "reaction",
      "text": "Ram Ram!",
      "voice": "english_male",
      "emotion": "warm"
    },
    {
      "id": "any.social_1",
      "npc": "any",
      "category": "social",
      "text": "Out together? Nice. Head to the lake, the evening's lovely.",
      "voice": "english_female",
      "emotion": "warm"
    },
    {
      "id": "any.idle_weather",
      "npc": "any",
      "category": "idle",
      "text": "Brutal heat today. Stay in the shade.",
      "voice": "english_male",
      "emotion": "neutral"
    },
    {
      "id": "any.idle_cricket",
      "npc": "any",
      "category": "idle",
      "text": "Match at Green Park day after. Got tickets?",
      "voice": "english_male",
      "emotion": "happy"
    },
    {
      "id": "any.bye_1",
      "npc": "any",
      "category": "farewell",
      "text": "Alright, see you around.",
      "voice": "english_male",
      "emotion": "neutral"
    },
    {
      "id": "any.bye_2",
      "npc": "any",
      "category": "farewell",
      "text": "Okay, take care.",
      "voice": "english_female",
      "emotion": "warm"
    },
    {
      "id": "police_singh.offer_1",
      "npc": "police_singh",
      "category": "mission_offer",
      "text": "Listen. Go to the Nayaganj crossing and wait till the train passes. We don't spare gate-jumpers.",
      "emotion": "annoyed",
      "voice": "english_male",
      "mission": "crossing_patience"
    },
    {
      "id": "auto_raju.offer_3",
      "npc": "auto_raju",
      "category": "mission_offer",
      "text": "The Ghantaghar loop, boss: Civil Lines to Central, back via Naveen Market. Seven minutes. Eight hundred coins. In?",
      "emotion": "excited",
      "voice": "english_male",
      "mission": "ghantaghar_trial"
    },
    {
      "id": "ped_sunita.offer_1",
      "npc": "ped_sunita",
      "category": "mission_offer",
      "text": "Beta, drop my vegetable sacks at Green Park gate and Phool Bagh before the evening rush, or the tomatoes are done for.",
      "emotion": "neutral",
      "voice": "english_female",
      "mission": "sabzi_run"
    },
    {
      "id": "ped_rekha.offer_1",
      "npc": "ped_rekha",
      "category": "mission_offer",
      "text": "You've got a car? Drop me from Central to Bada Chauraha, the auto guys want three hundred!",
      "emotion": "happy",
      "voice": "english_female",
      "mission": "station_taxi"
    },
    {
      "id": "guide_babloo.offer_3",
      "npc": "guide_babloo",
      "category": "mission_offer",
      "text": "A treasure hunt. First clue: go where red cloth was once woven. Then Chunniganj, then the lake.",
      "emotion": "sly",
      "voice": "english_male",
      "mission": "lal_imli_hunt"
    },
    {
      "id": "ped_aman.offer_1",
      "npc": "ped_aman",
      "category": "mission_offer",
      "text": "Bro, I need two photos for Insta: Nana Rao Park and Phool Bagh. Coming?",
      "emotion": "happy",
      "voice": "english_male",
      "mission": "park_photo"
    },
    {
      "id": "chai_munna.offer_2",
      "npc": "chai_munna",
      "category": "mission_offer",
      "text": "Evenings by Moti Jheel are something else. Take someone along, sit a minute, then tell me.",
      "emotion": "warm",
      "voice": "english_male",
      "mission": "evening_jheel"
    },
    {
      "id": "any.crossing_wait",
      "npc": "any",
      "category": "reaction",
      "text": "Hey, stop! The train's coming!",
      "emotion": "annoyed",
      "voice": "english_male"
    },
    {
      "id": "any.greet_morning",
      "npc": "any",
      "category": "idle",
      "text": "Out this early? Chai first.",
      "emotion": "happy",
      "voice": "english_male"
    },
    {
      "id": "any.greet_evening",
      "npc": "any",
      "category": "idle",
      "text": "Lovely evening today.",
      "emotion": "warm",
      "voice": "english_female"
    },
    {
      "id": "paan_chacha.greet_1",
      "npc": "paan_chacha",
      "category": "shop",
      "text": "Welcome to Nukkad Paan, our fictional street shop. What would you like?",
      "emotion": "warm"
    },
    {
      "id": "guide_babloo.laddoo",
      "npc": "guide_babloo",
      "category": "mission_offer",
      "text": "A festival caper, all staged! Bring the golden laddoo back from fictional Sunehri Mithai.",
      "emotion": "happy",
      "mission": "laddoo_chakkar"
    },
    {
      "id": "guide_babloo.story_1",
      "npc": "guide_babloo",
      "category": "mission_offer",
      "text": "Tommy, did four years make you forget Mall Road? Come on, see the city first.",
      "emotion": "warm",
      "mission": "story_01_wapsi"
    },
    {
      "id": "guide_babloo.story_8",
      "npc": "guide_babloo",
      "category": "mission_offer",
      "text": "It's mela night. The Seth is about to run. Ready?",
      "emotion": "warm",
      "mission": "story_08_finale"
    },
    {
      "id": "auto_raju.story_3",
      "npc": "auto_raju",
      "category": "mission_offer",
      "text": "Listen! The Seth's posters are all over Mall Road. Will you clear them?",
      "emotion": "warm",
      "mission": "story_03_mall_road"
    },
    {
      "id": "police_singh.story_4",
      "npc": "police_singh",
      "category": "mission_offer",
      "text": "The Seth's box leaves on today's train. Respect the rules at the crossing.",
      "emotion": "warm",
      "mission": "story_04_railway"
    },
    {
      "id": "police_singh.story_7",
      "npc": "police_singh",
      "category": "mission_offer",
      "text": "There's a rumour the mela is cancelled. I need evidence in six minutes.",
      "emotion": "warm",
      "mission": "story_07_danger"
    },
    {
      "id": "shop_gupta.story_5",
      "npc": "shop_gupta",
      "category": "mission_offer",
      "text": "There's a machine running behind my shop at night. Will you find out?",
      "emotion": "warm",
      "mission": "story_05_naveen"
    },
    {
      "id": "chai_munna.story_6",
      "npc": "chai_munna",
      "category": "mission_offer",
      "text": "Tommy, head for the ghat. My brother is waiting at the lake.",
      "emotion": "warm",
      "mission": "story_06_ghat"
    }
  ]
}
